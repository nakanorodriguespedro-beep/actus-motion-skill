{
  "name": "motion-remotion-3d",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Remotion + three.js template for the actus-motion skill: one 3D object, one continuous camera, every format.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "brand": "node scripts/sync-brand.mjs",
    "dev": "node scripts/sync-brand.mjs && remotion studio src/index.ts",
    "render": "node scripts/render-all.mjs",
    "typecheck": "node scripts/sync-brand.mjs && tsc"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.529",
    "@remotion/three": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
